{
  "name": "powerllm-frontend",
  "version": "6.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "build": "max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "eslint --fix",
    "check:locales": "node scripts/check-locales.mjs",
    "lint-staged": "lint-staged",
    "openapi": "max openapi",
    "prepare": "test -d ../.git && husky install || true",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:dev": "cross-env REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "tunnel": "bash scripts/tunnel-9997.sh",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit --skipLibCheck --pretty",
    "pre-commit": "lint-staged --shell"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,less,scss}": "prettier --write"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/plots": "^2.3.2",
    "@ant-design/pro-components": "^2.8.10",
    "@monaco-editor/react": "^4.6.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.19",
    "@uiw/react-json-view": "2.0.0-alpha.32",
    "@umijs/route-utils": "^4.0.3",
    "ahooks": "^3.8.1",
    "antd": "^5.29.2",
    "antd-style": "^3.7.1",
    "classnames": "^2.5.1",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.44.0",
    "nunjucks": "^3.2.4",
    "qs": "^6.13.1",
    "querystring": "^0.2.1",
    "rc-menu": "^9.16.0",
    "rc-resize-observer": "^1.4.0",
    "rc-util": "^5.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "react-window": "^1.8.11",
    "recharts": "^3.6.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.5",
    "umi-request": "^1.4.0"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.3.0",
    "@testing-library/react": "^13.4.0",
    "@types/express": "^4.17.21",
    "@types/history": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/node": "18.15.0",
    "@types/nunjucks": "^3.2.6",
    "@types/qs": "^6.9.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-helmet": "^6.1.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-window": "^1.8.8",
    "@umijs/fabric": "^2.14.1",
    "@umijs/lint": "^4.3.35",
    "@umijs/max": "^4.3.35",
    "autoprefixer": "^10.4.20",
    "code-inspector-plugin": "^0.13.0",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "cross-port-killer": "^1.4.0",
    "detect-installer": "^1.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "express": "^4.21.1",
    "gh-pages": "^3.2.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^10.5.4",
    "mockjs": "^1.1.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "prettier": "^2.8.8",
    "react-dev-inspector": "^1.9.0",
    "sql-formatter": "^13.1.0",
    "swagger-ui-dist": "^5.18.2",
    "tailwindcss": "^3.4.15",
    "ts-md5": "^1.3.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "umi-presets-pro": "^2.0.3",
    "umi-serve": "^1.9.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "create-umi": {
    "ignoreScript": [
      "docker*",
      "functions*",
      "site",
      "generateMock"
    ],
    "ignoreDependencies": [
      "netlify*",
      "serverless"
    ],
    "ignore": [
      ".dockerignore",
      ".git",
      ".github",
      ".gitpod.yml",
      "CODE_OF_CONDUCT.md",
      "Dockerfile",
      "Dockerfile.*",
      "lambda",
      "LICENSE",
      "netlify.toml",
      "README.*.md",
      "azure-pipelines.yml",
      "docker",
      "CNAME",
      "create-umi"
    ]
  }
}
